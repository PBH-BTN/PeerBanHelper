                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">import com.install4j.api.ApplicationRegistry;
import com.install4j.api.update.UpdateChecker;
if (!"true".equals(String.valueOf(context.getVariable("pbhManagedUpdate")))) {
    return true;
}
var installed = ApplicationRegistry.getApplicationInfoByDir(context.getInstallationDirectory());
return installed != null &amp;&amp; context.getApplicationId().equals(installed.getId())
    &amp;&amp; context.getVersion().equals(context.getVariable("pbhManagedTarget"))
    &amp;&amp; context.getMediaFileId().equals(context.getVariable("pbhManagedMedia"))
    &amp;&amp; UpdateChecker.isVersionGreaterThan(context.getVersion(), installed.getVersion());</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
