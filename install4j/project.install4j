                      <property name="registryRoot" type="enum" class="com.install4j.api.windows.RegistryRoot" value="HKEY_CURRENT_USER" />
                      <property name="useDefault" type="boolean" value="true" />
                      <property name="valueName" type="string">{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}</property>
