      <application name="PBH managed updater" id="352" beanClass="com.install4j.runtime.beans.applications.CustomApplication" automaticLauncherIntegration="false">
        <serializedBean>
          <property name="executableName" type="string">pbh-managed-updater</property>
        </serializedBean>
        <startup>
          <screen id="354" beanClass="com.install4j.runtime.beans.screens.StartupScreen">
            <actions>
              <action name="Verify approved installer" id="355" beanClass="com.install4j.runtime.beans.actions.control.RunScriptAction" actionElevationType="none" failureStrategy="quit">
                <serializedBean>
                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">import com.install4j.api.ApplicationRegistry;
import com.install4j.api.update.UpdateChecker;
import java.nio.file.*;
import java.security.*;
import java.util.*;
var installed = ApplicationRegistry.getApplicationInfoByDir(context.getInstallationDirectory());
String target = (String) context.getVariable("pbhManagedVersion");
String media = (String) context.getVariable("pbhManagedMedia");
if (installed == null || !context.getApplicationId().equals(installed.getId())
    || target == null || !UpdateChecker.isVersionGreaterThan(target, installed.getVersion())
    || !Objects.equals(media, installed.getMediaSetId())) {
    return false;
}
var file = Path.of((String) context.getVariable("pbhManagedInstaller"));
var digest = MessageDigest.getInstance("SHA-256");
try (var stream = new DigestInputStream(Files.newInputStream(file), digest)) {
    stream.transferTo(java.io.OutputStream.nullOutputStream());
}
if (!HexFormat.of().formatHex(digest.digest()).equalsIgnoreCase((String) context.getVariable("pbhManagedSha256"))) {
    return false;
}
return Util.isWindows() || Util.isMacOS() || file.toFile().setExecutable(true, true);</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
              <action id="356" beanClass="com.install4j.runtime.beans.actions.update.ShutdownCallingLauncherAction" actionElevationType="none" />
              <action name="Wait for PBH and set installer arguments" id="357" beanClass="com.install4j.runtime.beans.actions.control.RunScriptAction" failureStrategy="quit">
                <serializedBean>
                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">import java.util.*;
long caller = Long.parseLong((String) context.getVariable("pbhCallerPid"));
var process = ProcessHandle.of(caller);
if (process.isPresent()) {
    process.get().onExit().get(60, java.util.concurrent.TimeUnit.SECONDS);
}
var arguments = new ArrayList&lt;String&gt;();
arguments.addAll(List.of("-q", "-wait", "60", "-dir", context.getInstallationDirectory().getPath(),
    "-VpbhManagedUpdate=true", "-VpbhManagedTarget=" + context.getVariable("pbhManagedVersion"),
    "-VpbhManagedMedia=" + context.getVariable("pbhManagedMedia")));
String restart = (String) context.getVariable("pbhRestartLauncher");
if (restart != null &amp;&amp; !restart.isEmpty()) {
    arguments.add("-VpbhRestartLauncher=" + restart);
    if ("291".equals(restart)) {
        arguments.add("-VregisterSystemService=true");
    }
}
context.setVariable("pbhManagedInstallerArguments", arguments.toArray(new String[0]));
return true;</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
              <action name="Run approved installer" id="362" beanClass="com.install4j.runtime.beans.actions.misc.RunExecutableAction" failureStrategy="quit">
                <serializedBean>
                  <property name="arguments" type="array" elementType="string" length="1">
                    <element index="0">${installer:pbhManagedInstallerArguments}</element>
                  </property>
                  <property name="executable">
                    <object class="java.io.File">
                      <string>${installer:pbhManagedInstaller}</string>
                    </object>
                  </property>
                  <property name="wait" type="boolean" value="true" />
                  <property name="returnCodeVariable" type="string">pbhManagedExitCode</property>
                </serializedBean>
              </action>
              <action name="Clean verified download" id="363" beanClass="com.install4j.runtime.beans.actions.control.RunScriptAction" failureStrategy="quit">
                <serializedBean>
                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">import java.nio.file.*;
var file = Path.of((String) context.getVariable("pbhManagedInstaller"));
Files.deleteIfExists(file);
Files.deleteIfExists(file.getParent());
return Integer.valueOf(0).equals(context.getVariable("pbhManagedExitCode"));</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
            </actions>
          </screen>
        </startup>
      </application>
    </applications>
